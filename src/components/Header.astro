---
import { ui, type Lang } from "../i18n/ui";
import { routes } from "../i18n/routes";

interface Props {
  lang: Lang;
  alternatePath: string;
}

const { lang, alternatePath } = Astro.props;
const t = ui[lang];
const productsHref = `${routes.home[lang]}#${t.anchors.products}`;
const labelWidth = lang === "pl" ? "4.1rem" : "3rem";
---

<header class="header">
  <div class="header__left">
    <a class="header__logo" href={routes.home[lang]} aria-label={t.header.homeLabel}>
      <svg aria-hidden="true"><use href="#logo"></use></svg>
      <span class="header__word" translate="no">Aurea</span>
    </a>
  </div>
  <div class="header__main" style={`--menu-label-width:${labelWidth}`}>
    <button
      class="header__menu-btn"
      type="button"
      aria-expanded="false"
      aria-controls="site-menu"
      aria-label={t.header.openMenu}
      data-open-label={t.header.openMenu}
      data-close-label={t.header.closeMenu}
      data-menu-text={t.header.menuLabel}
      data-close-text={t.header.closeLabel}
    >
      <span class="header__burger" aria-hidden="true"><span class="header__line"></span><span class="header__line"></span></span>
      <span class="header__menu-label u-btn">{t.header.menuLabel}</span>
    </button>
    <button class="header__round" type="button" data-theme-toggle aria-label={t.header.themeLabel}>
      <svg class="header__moon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" aria-hidden="true"><path d="M13.5 9.6A5.8 5.8 0 0 1 6.4 2.5a5.8 5.8 0 1 0 7.1 7.1z"></path></svg>
      <svg class="header__sun" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"><circle cx="10" cy="10" r="3.6"></circle><path d="M10 2v1.8M10 16.2V18M2 10h1.8M16.2 10H18M4.34 4.34l1.27 1.27M14.39 14.39l1.27 1.27M4.34 15.66l1.27-1.27M14.39 5.61l1.27-1.27"></path></svg>
    </button>
    <div class="header__prc" aria-hidden="true"><span id="progress" class="u-btn">0%</span></div>
  </div>
  <div class="header__right">
    <a class="header__round is-lang is-header-btn" href={alternatePath} hreflang={lang === "pl" ? "en" : "pl"} aria-label={t.header.switchLabel}>{t.header.switchShort}</a>
    <a class="btn is-header-btn" href={productsHref} hover-stagger-wrap><span class="u-btn" hover-stagger>{t.header.cta}</span></a>
  </div>
</header>
